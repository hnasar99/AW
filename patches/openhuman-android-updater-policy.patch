@@ -0,0 +1,33 @@
+//! Android updates belong to the signed host app, never the desktop updater.
+
+use super::*;
+
+#[test]
+fn reports_an_android_target_without_advertising_binary_updates() {
+    assert!(matches!(
+        platform_triple(),
+        "aarch64-linux-android" | "x86_64-linux-android"
+    ));
+    assert!(ensure_binary_updates_supported().is_err());
+}
+
+#[tokio::test]
+async fn refuses_update_requests_before_network_or_staging() {
+    let expected = ensure_binary_updates_supported().unwrap_err();
+    // Deliberately invalid URLs distinguish a platform refusal from a client
+    // error and ensure a regressed guard cannot send a real network request.
+    let check = check_available_with_base_url("invalid update origin").await;
+    assert_eq!(check.unwrap_err(), expected);
+
+    let directory = tempfile::tempdir().expect("private test directory");
+    let staging = directory.path().join("must-not-be-created");
+    let download = download_and_stage_with_version(
+        "invalid download URL",
+        "openhuman-core",
+        Some(staging.clone()),
+        None,
+    )
+    .await;
+    assert_eq!(download.unwrap_err(), expected);
+    assert!(!staging.exists(), "Android must not stage an executable");
+}
