+//! Wallet-host response limits before JSON/SSE assembly.
+//!
+//! This cap also handles an SSE peer that sends no newline or progress event.
+
+use crate::{Error, Result};
+
+const HOST_MAX_RESPONSE_BYTES: usize = 2 * 1024 * 1024;
+
+pub(super) fn bounded_response_chunk(
+    total: &mut usize,
+    chunk: bytes::Bytes,
+) -> Result<bytes::Bytes> {
+    *total = total.saturating_add(chunk.len());
+    if *total > HOST_MAX_RESPONSE_BYTES {
+        return Err(Error::Model(
+            "provider response exceeded the host byte limit".into(),
+        ));
+    }
+    Ok(chunk)
+}
+
+pub(super) async fn bounded_response_text(mut response: reqwest::Response) -> Result<String> {
+    if response
+        .content_length()
+        .is_some_and(|size| size > HOST_MAX_RESPONSE_BYTES as u64)
+    {
+        return Err(Error::Model(
+            "provider response exceeded the host byte limit".into(),
+        ));
+    }
+    let mut total = 0usize;
+    let mut body = Vec::new();
+    while let Some(chunk) = response
+        .chunk()
+        .await
+        .map_err(|_| Error::Model("provider response body could not be read".into()))?
+    {
+        let chunk = bounded_response_chunk(&mut total, chunk)?;
+        body.extend_from_slice(&chunk);
+    }
+    String::from_utf8(body).map_err(|_| Error::Model("provider response was not UTF-8".into()))
+}
