+use super::*;
+
+#[test]
+fn chunk_limit_is_cumulative() {
+    let mut total = HOST_MAX_RESPONSE_BYTES - 1;
+    assert!(bounded_response_chunk(&mut total, bytes::Bytes::from_static(b"a")).is_ok());
+    assert!(bounded_response_chunk(&mut total, bytes::Bytes::from_static(b"b")).is_err());
+}
+
+#[test]
+fn byte_counter_does_not_wrap() {
+    let mut total = usize::MAX;
+    assert!(bounded_response_chunk(&mut total, bytes::Bytes::from_static(b"a")).is_err());
+}
+
+#[test]
+fn a_single_oversized_frame_is_refused_before_accumulation() {
+    let mut total = 0;
+    let bytes = bytes::Bytes::from(vec![b'x'; HOST_MAX_RESPONSE_BYTES + 1]);
+    assert!(bounded_response_chunk(&mut total, bytes).is_err());
+}
