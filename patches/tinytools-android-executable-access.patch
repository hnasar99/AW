         rustix::fs::accessat(
             rustix::fs::CWD,
@@ -73,6 +73,23 @@ fn is_executable_file(path: &std::path::Path) -> bool {
         )
         .is_ok()
     }
+    // rustix's Android libc backend does not expose AT_EACCESS. A normal
+    // Android app runs under one app UID/GID, so access() checks the same
+    // credentials. Refuse the probe when real/effective IDs differ instead
+    // of silently substituting a different identity or checking mode bits.
+    #[cfg(target_os = "android")]
+    {
+        if rustix::process::getuid() != rustix::process::geteuid()
+            || rustix::process::getgid() != rustix::process::getegid()
+        {
+            return false;
+        }
+        rustix::fs::access(
+            path.as_os_str().as_encoded_bytes(),
+            rustix::fs::Access::EXEC_OK,
+        )
+        .is_ok()
+    }
     #[cfg(not(unix))]
