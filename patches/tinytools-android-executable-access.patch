-# Safe effective-credential executable checks for Unix PATH candidates.
-rustix = { version = "1", default-features = false, features = ["fs"] }
+# Safe executable checks; Android also compares real and effective credentials.
+rustix = { version = "1", default-features = false, features = ["fs", "process"] }
 serde_json = { workspace = true }
 # `curl` reports the SHA-256 of what it downloaded.
 sha2 = "0.11"
